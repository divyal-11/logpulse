# -----------------------------------------------------------------------------
# LogPulse Environment Configuration
# -----------------------------------------------------------------------------

# PostgreSQL 16 (Hot Storage)
POSTGRES_USER=logpulse_admin
POSTGRES_PASSWORD=logpulse_secure_password
POSTGRES_DB=logpulse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://logpulse_admin:logpulse_secure_password@localhost:5432/logpulse

# Read-Only AI Role (LangGraph Agent Security Sandbox)
POSTGRES_RO_USER=logpulse_agent_readonly
POSTGRES_RO_PASSWORD=agent_readonly_pass
DATABASE_RO_URL=postgresql://logpulse_agent_readonly:agent_readonly_pass@localhost:5432/logpulse

# Redis 7 (In-Memory Buffer & Streams)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
REDIS_STREAM_RAW=stream:logs:raw
REDIS_STREAM_DEAD_LETTER=stream:logs:dead-letter
REDIS_CONSUMER_GROUP=group:parsers

# MinIO / S3 (Cold Storage Archive)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=logpulse-cold-archive
MINIO_USE_SSL=false

# Ingestion API Gateway
INGEST_API_PORT=4000
INGEST_RATE_LIMIT_PER_MINUTE=5000

# Anomaly Detection Service (FastAPI)
ANOMALY_DETECTOR_PORT=8000
ANOMALY_DETECTOR_URL=http://localhost:8000
ANOMALY_THRESHOLD=-0.15

# LangGraph Incident Triage Service
TRIAGE_AGENT_PORT=8001
TRIAGE_AGENT_URL=http://localhost:8001

